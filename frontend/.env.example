# Copy to .env.local for local development. Never commit a real .env.local file.

# Base URL the frontend uses to reach the FastAPI backend (Phase 08).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Client-side pre-check only; must match (or be <=) the backend's
# MAX_UPLOAD_SIZE_BYTES (see root .env.example) -- the backend remains the
# authoritative limit regardless of this value.
NEXT_PUBLIC_MAX_UPLOAD_MB=5
