# Environment variable conventions for PlantCare AI (Phase 01 scaffold).
# Copy to .env for local development. Never commit a real .env file.

# --- Backend (FastAPI) ---
# Comma-separated list of allowed frontend origins for CORS.
BACKEND_CORS_ORIGINS=http://localhost:3000
# Directory containing trained model artifacts (loaded once at startup).
MODEL_ARTIFACTS_DIR=ml/artifacts
# Maximum accepted upload size, in bytes.
MAX_UPLOAD_SIZE_BYTES=5242880
# Path to the trained Stage 2 checkpoint, loaded once at startup (Phase 08).
MODEL_PATH=ml/artifacts/stage2/best_model.keras
# Path to the class name -> index mapping.
CLASS_MAPPING_PATH=data/class_mapping.json
# Path to the static disease/class information used by /diseases.
DISEASE_INFO_PATH=data/disease_info.json
# Path to the Phase 06 evaluation report (optional; metrics omitted if absent).
EVALUATION_METRICS_PATH=ml/artifacts/evaluation/metrics.json
# Comma-separated list of accepted upload content types.
ALLOWED_UPLOAD_CONTENT_TYPES=image/jpeg,image/png,image/webp
# Default number of top-k predictions returned by /predict.
DEFAULT_TOP_K=5

# --- Frontend (Next.js) ---
# Base URL the frontend uses to reach the FastAPI backend.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
